# Copy to .env and fill in your keys. Do NOT commit .env or submit it in a zip.

# LLM reranking + diagnosis (--llm). Default: OpenRouter in config.yaml
OPENROUTER_API_KEY=your_openrouter_key_here

# VLM screenshot analysis (--vlm). Default: Groq in config.yaml
GROQ_API_KEY=your_groq_key_here

# Optional alternates if you change config.yaml model providers:
# GEMINI_API_KEY=your_gemini_key_here
